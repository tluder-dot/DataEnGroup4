# Copy this file to .env (which is never committed) and fill it in.
# Values arrive with the lessons that need them.

# L02: the course project (shared by the whole cohort) and our group's
# resources. Names and who creates them: CONTRIBUTING.md, "Shared resources".
GCP_PROJECT_ID=data-engineering-i1
GCP_REGION=europe-west1
GCS_BUCKET=data-engineering-i1-jeet
BQ_BRONZE_DATASET=jeet_bronze

# L03: the company stack, running locally with docker compose. These are the
# stack's public local defaults, not secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=clickstream
