# Secrets: never commit these
.env
.env.*
!.env.example
*-key.json
*credentials*.json
service-account*.json

# Local data
data/
*.parquet

# The legacy export and anything copied from it: it holds plaintext passwords
# and card numbers (synthetic, but never committed)
*.csv
!transform/seeds/*.csv
*.tar.gz
legacy_csv/

# Local pipeline output (the clickstream consumer's default OUT and DLQ)
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# dbt
transform/target/
transform/dbt_packages/
transform/logs/
transform/.user.yml

# Terraform (the .terraform.lock.hcl file is committed on purpose)
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# Airflow
orchestration/logs/

# Editors and OS
.idea/
.DS_Store
Thumbs.db
