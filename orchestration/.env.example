# Copy to orchestration/.env (never committed) and fill in your own values.
AIRFLOW_UID=50000
# The repo on your laptop, as an absolute path with forward slashes.
REPO_DIR=/Users/<you>/de/DataEnGroup4
# Your gcloud folder: macOS /Users/<you>/.config/gcloud,
# Windows C:/Users/<you>/AppData/Roaming/gcloud
GCLOUD_DIR=/Users/<you>/.config/gcloud
# A Discord webhook URL. A secret: only in .env.
ALERT_WEBHOOK=
